{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "./node_modules/.tmp",
    "jsx": "react-jsx",
    "strict": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "agentDocs.ts",
    "src/data/content.ts",
    "src/data/notes.ts",
    "src/formatDate.ts",
    "src/i18n.tsx"
  ]
}